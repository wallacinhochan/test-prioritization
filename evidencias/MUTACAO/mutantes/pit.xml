      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.19.4</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <features><feature>+EXPORT</feature></features>
          <mutators><mutator>DEFAULTS</mutator></mutators>
          <outputFormats><outputFormat>XML</outputFormat></outputFormats>
          <threads>1</threads>
          <timestampedReports>false</timestampedReports>
          <reportsDirectory>/evidencia/pit/exportacao</reportsDirectory>
          <jvmArgs>
            <jvmArg>-Duser.timezone=UTC</jvmArg>
            <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.time=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-opens=java.base/java.time.chrono=ALL-UNNAMED</jvmArg>
          </jvmArgs>
        </configuration>
      </plugin>
